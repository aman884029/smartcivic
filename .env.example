JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_NAME=SmartCivic Administrator
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
NGO_NAME=SmartCivic NGO
NGO_EMAIL=ngo@your-domain.example
NGO_PASSWORD=use-a-different-unique-password-of-at-least-12-characters
# Resend is the recommended email provider on Render Free (HTTPS API).
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=SmartCivic <no-reply@your-verified-domain.example>
# Optional SMTP fallback for hosting providers that allow SMTP egress.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
# Optional: use a persistent disk mounted at this path on Render.
DATA_DIR=./data
UPLOAD_DIR=./uploads
